<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GOT.Panel</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GOT.Panel.styles.css" asp-append-version="true" />

    <link href="~/lib/font-awesome/css/all.css" rel="stylesheet" />
    <link href="~/lib/font-awesome/css/all.min.css" rel="stylesheet" />
</head>
<body>

    <header class="main-header">

        <div class="header-left">

            <div class="brand">
                <i class="fa-solid fa-crown logo-icon"></i>
                <span class="logo-text">Panel GOT</span>
            </div>

        </div>

        <nav class="header-center">
            <ul class="nav-menu">
                <li>
                    <a asp-action="Index" asp-controller="Home" title="Inicio" class="nav-item nav-active">
                        <i class="fa-solid fa-house icon-home"></i>Home
                    </a>
                </li>

                <li>
                    <a asp-action="Season" asp-controller="Season" title="Temporadas" class="nav-item">
                        <i class="fa-solid fa-calendar-days"></i>
                    </a>
                </li>

                <li>
                    <a asp-action="Person" asp-controller="Person" title="Personas" class="nav-item">
                        <i class="fa-solid fa-person"></i>
                    </a>
                </li>

                <li>
                    <a asp-action="Kingdom" asp-controller="Kingdom" title="Reinos" class="nav-item">
                        <i class="fa-solid fa-crown"></i>
                    </a>
                </li>

                <li>
                    <a asp-action="DeathCategory" asp-controller="DeathCategory" title="Categorias de muertes" class="nav-item">
                        <i class="fa-solid fa-skull"></i>
                    </a>
                </li>

                <li>
                    <a asp-action="BattleType" asp-controller="BattleType" title="Tipos de Batallas" class="nav-item">
                        <i class="fa-solid fa-person-rifle"></i>
                    </a>
                </li>

            </ul>
        </nav>

        <div class="header-right">

            <a href="#" title="Configuraciones" class="header-icon">
                <i class="fa-solid fa-gear"></i>
            </a>

            <a href="#" title="Salir" class="header-icon logout-icon">
                <i class="fa-solid fa-right-from-bracket"></i>
            </a>

        </div>

    </header>
    
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - GOT.Panel - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
